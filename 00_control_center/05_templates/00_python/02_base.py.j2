from __future__ import annotations

from abc import ABC


class {{ component.base_class_name }}(ABC):
    """
    Base class for {{ component.name }}.
    """

    def __init__(self) -> None:

        self.name = "{{ component.name }}"
        self.version = "{{ version.current.full_version }}"
        self.status = "Ready"

    def info(self) -> dict:
        """
        Return component metadata.
        """

        return {
            "name": self.name,
            "version": self.version,
            "status": self.status,
        }